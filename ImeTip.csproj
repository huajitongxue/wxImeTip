<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用的 NotifyIcon 来自 WinForms：WPF 本身没有托盘图标控件 -->
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      程序图标。资源管理器、任务栏、窗口标题栏都显示它。
      图标由 tools/make-icon.py 生成：想改配色或形状就改那个脚本再跑一遍。
    -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      打开 UseWindowsForms 后，SDK 会把 System.Drawing / System.Windows.Forms
      塞进"隐式 using"，而这会跟 WPF 的 System.Windows.Media 打架
      （典型症状：Color / Brush / Point 变成"不明确的引用"）。
      这里移除掉，改为只在 TrayIcon.cs 里显式 using。
    -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!--
      托盘图标的三个状态（中 / 英 / 读不到）作为嵌入资源打进程序集，见 TrayIcon.cs。
      为什么不复用上面那个 icon.ico：exe 图标是静态的"中英并列"，
      而托盘图标要跟着输入法状态实时切换，两者本来就是不同的图。
    -->
    <EmbeddedResource Include="assets\tray-zh.ico" />
    <EmbeddedResource Include="assets\tray-en.ico" />
    <EmbeddedResource Include="assets\tray-unknown.ico" />
  </ItemGroup>

  <!--
    每次 publish 后，自动把面向使用者的《使用说明.md》复制到输出目录并改名 README.md。

    为什么要自动化：发布目录会被重新生成，手工放进去的说明文件迟早会丢。
    这样"发出去的那个文件夹"里永远带着使用说明。
  -->
  <Target Name="CopyUserGuideToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\使用说明.md"
          DestinationFiles="$(PublishDir)README.md"
          Condition="Exists('$(MSBuildProjectDirectory)\使用说明.md')" />
  </Target>

</Project>
