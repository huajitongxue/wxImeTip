<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用的 NotifyIcon 来自 WinForms：WPF 本身没有托盘图标控件 -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!--
      打开 UseWindowsForms 后，SDK 会把 System.Drawing / System.Windows.Forms
      塞进"隐式 using"，而这会跟 WPF 的 System.Windows.Media 打架
      （典型症状：Color / Brush / Point 变成"不明确的引用"）。
      这里移除掉，改为只在 TrayIcon.cs 里显式 using。
    -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!--
    每次 publish 后，自动把面向使用者的《使用说明.md》复制到输出目录并改名 README.md。

    为什么要自动化：发布目录会被重新生成，手工放进去的说明文件迟早会丢。
    这样"发出去的那个文件夹"里永远带着使用说明。
  -->
  <Target Name="CopyUserGuideToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\使用说明.md"
          DestinationFiles="$(PublishDir)README.md"
          Condition="Exists('$(MSBuildProjectDirectory)\使用说明.md')" />
  </Target>

</Project>
