<Window x:Class="ImeTip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImeTip 设置"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">

    <!--
        刻意用系统默认标题栏（不设 WindowStyle="None"）：
        省掉一整套自绘边框/拖动/关闭按钮的代码，风险最低。
        本文件是"设置窗口"，可以正常获得焦点——它和悬浮窗那种 NOACTIVATE 的特例完全不同。
    -->
    <Window.Resources>
        <!--
            颜色走资源而不是"靠 Window.Foreground 继承"。
            原因：之前实测发现 Window 的前景色并不能可靠地传到每个 TextBlock 上，
            标题标签和背景几乎同色、根本看不见字。显式指定最稳。

            注意这里是**具名** Style（x:Key），刻意不做成隐式 Style：
            隐式 Style 会连 ComboBox / Slider 模板内部的 TextBlock 一起染色，
            那些控件用的是系统浅色底，被染成浅色字就彻底看不见了。
        -->
        <SolidColorBrush x:Key="LabelBrush" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="HintBrush" Color="#A8A8A8"/>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Body" Margin="18">

        <TextBlock Text="主题" FontWeight="SemiBold" Style="{StaticResource LabelText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <!--
                ⚠️ 这几个控件必须**逐个显式**指定 Foreground。
                它们**不会**继承 Window.Foreground —— WPF 的主题样式会给
                RadioButton / CheckBox / ComboBox 设死一个黑色前景，
                结果就是"深色背景上写黑字"，完全看不见。
                （这是实测出来的：遍历视觉树打印各自的前景色，
                 这几个控件的值都是 #FF000000。）
            -->
            <RadioButton x:Name="DarkRadio"  Content="深色" Margin="0,0,16,0"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnThemeChecked"/>
            <RadioButton x:Name="LightRadio" Content="浅色" Margin="0,0,16,0"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnThemeChecked"/>
            <RadioButton x:Name="TransRadio" Content="透明"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnThemeChecked"/>
        </StackPanel>

        <TextBlock Text="背景不透明度" FontWeight="SemiBold" Margin="0,18,0,0"
                   Style="{StaticResource LabelText}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0"
                    Minimum="0" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    ValueChanged="OnOpacityChanged"/>
            <TextBlock x:Name="OpacityText" Grid.Column="1"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Style="{StaticResource LabelText}"/>
        </Grid>

        <CheckBox x:Name="BorderCheck" Content="显示卡片边框" Margin="0,6,0,0"
                  Foreground="{DynamicResource LabelBrush}"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <CheckBox x:Name="OutlineCheck" Content="文字加描边（背景透明时保证看得清）" Margin="0,10,0,0"
                  Foreground="{DynamicResource LabelBrush}"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

        <TextBlock Text="背景模糊" FontWeight="SemiBold" Margin="0,18,0,0"
                   Style="{StaticResource LabelText}"/>
        <!--
            这里原先是个 ComboBox，但它有个绕不过去的毛病：
            **下拉框本身和展开的列表在系统默认模板里都是白底**，
            而本窗口是深色背景、文字也是浅色 —— 结果就是"白底白字"，什么都看不见。
            下拉列表还是个独立弹出窗口，想让主题色跟进去必须整个重写控件模板，不值得。

            反正只有 3 个固定选项，改用单选按钮：显示效果完全可控，
            而且和上面「主题」那一行的交互方式一致。
        -->
        <StackPanel x:Name="BlurPanel" Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="BlurNoneRadio" Content="无" Margin="0,0,16,0"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnBlurOptionChanged"/>
            <RadioButton x:Name="BlurBlurRadio" Content="模糊" Margin="0,0,16,0"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnBlurOptionChanged"/>
            <RadioButton x:Name="BlurAcrylicRadio" Content="亚克力"
                         Foreground="{DynamicResource LabelBrush}"
                         Checked="OnBlurOptionChanged"/>
        </StackPanel>
        <TextBlock x:Name="BlurHint" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource HintBrush}"/>

        <!--
            ═══════════ 快捷键 ═══════════
            以后再加新快捷键，就在这个区块里继续往下加控件（CheckBox / 下拉框都行），
            每项独立一个开关、互不影响。后台那边只要在 HotkeyManager 里多接一个动作。
        -->
        <TextBlock Text="快捷键" FontWeight="SemiBold" Margin="0,18,0,0"
                   Style="{StaticResource LabelText}"/>
        <CheckBox x:Name="SummonHotkeyCheck" Content="按一下 Ctrl，把方框召到鼠标旁边" Margin="0,8,0,0"
                  Foreground="{DynamicResource LabelBrush}"
                  Checked="OnHotkeyOptionChanged" Unchecked="OnHotkeyOptionChanged"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource HintBrush}"
                   Text="只认「单独按一下 Ctrl」：中途按了别的键就不算数。所以 Ctrl+C 复制、Ctrl+滚轮 缩放都不会让方框乱跳。关掉时程序会彻底卸载键盘钩子，一个按键都不再监听。"/>

        <!--
            ═══════════ 诊断 ═══════════
            排查问题用的开关都放这里，默认一律关闭 ——
            正常使用时不需要，开着反而添乱。
        -->
        <TextBlock Text="诊断" FontWeight="SemiBold" Margin="0,18,0,0"
                   Style="{StaticResource LabelText}"/>
        <CheckBox x:Name="DebugTipCheck" Content="鼠标悬停时显示原始数据" Margin="0,8,0,0"
                  Foreground="{DynamicResource LabelBrush}"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource HintBrush}"
                   Text="打开后，鼠标扫过小方块会弹出一大段读取到的原始数据（模式、命中的规则、原始句柄、刷新计数等）。只在怀疑「显示的状态对不对」时才需要。"/>

        <TextBlock x:Name="ScopeHint" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"
                   Foreground="{DynamicResource HintBrush}"/>
    </StackPanel>
</Window>
