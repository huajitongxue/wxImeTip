<Window x:Class="ImeTip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImeTip 设置"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">

    <!--
        刻意用系统默认标题栏（不设 WindowStyle="None"）：
        省掉一整套自绘边框/拖动/关闭按钮的代码，风险最低。
        本文件是"设置窗口"，可以正常获得焦点——它和悬浮窗那种 NOACTIVATE 的特例完全不同。
    -->
    <StackPanel x:Name="Body" Margin="18">

        <TextBlock Text="主题" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="DarkRadio"  Content="深色" Margin="0,0,16,0"
                         Checked="OnThemeChecked"/>
            <RadioButton x:Name="LightRadio" Content="浅色" Margin="0,0,16,0"
                         Checked="OnThemeChecked"/>
            <RadioButton x:Name="TransRadio" Content="透明"
                         Checked="OnThemeChecked"/>
        </StackPanel>

        <TextBlock Text="背景不透明度" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0"
                    Minimum="0" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    ValueChanged="OnOpacityChanged"/>
            <TextBlock x:Name="OpacityText" Grid.Column="1"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <CheckBox x:Name="BorderCheck" Content="显示卡片边框" Margin="0,6,0,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <CheckBox x:Name="OutlineCheck" Content="文字加描边（背景透明时保证看得清）" Margin="0,10,0,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

        <TextBlock Text="背景模糊" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <ComboBox x:Name="BlurCombo" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0"
                  SelectionChanged="OnBlurChanged"/>
        <TextBlock x:Name="BlurHint" TextWrapping="Wrap" Margin="0,6,0,0"
                   FontSize="12" Opacity="0.75"/>

        <TextBlock x:Name="ScopeHint" TextWrapping="Wrap" Margin="0,16,0,0"
                   FontSize="12" Opacity="0.75"/>
    </StackPanel>
</Window>
